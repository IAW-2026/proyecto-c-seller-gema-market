// UniHousing — Seller App
//
// Schema base del bounded context Seller.
// Decisiones de modelado deben quedar reflejadas en docs/modelo-de-datos-seller.md.
//
// IDs: se usa cuid() en lugar de ULID (que indica el modelo de datos) porque Prisma
// no tiene generador ULID nativo. La forma del ID es opaca para la lógica de negocio;
// se puede migrar a ULID con un generador externo en cualquier momento sin cambiar las
// relaciones.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SellerRole {
  seller
}

enum ProductStatus {
  active
  paused
}

// Solo dos estados válidos. El data layer convierte el valor del DB al tipo de dominio.
enum ProductCondition {
  nuevo
  usado
}

// Alineado con venta.status del modelo de datos y con el tipo OrderStatus del dominio.
enum SaleStatus {
  pending_payment
  paid
  shipping
  delivered
  shipping_failed
  cancelled
  disputed
  refunded
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Caché local del usuario de Clerk. clerk_user_id es la fuente de verdad.
model Seller {
  id          String     @id @default(cuid())
  clerkUserId String?    @unique
  fullName    String
  shopName    String
  email       String     @unique
  phone       String
  bio         String?
  role        SellerRole @default(seller)
  city        String
  street      String
  number      String
  apartment   String?
  postalCode  String
  products    Product[]
  sales       Sale[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Categoria {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id           String           @id @default(cuid())
  sellerId     String
  title        String
  description  String
  weight       Int
  height       Int
  width        Int
  depth        Int
  condition    ProductCondition @default(nuevo)
  material     String
  color        String
  price        Decimal          @db.Decimal(10, 2)
  currency     String           @default("ARS") @db.Char(3)
  categoryId   String
  stock        Int              @default(0)
  status       ProductStatus    @default(active)
  images       Json             @default("[]")
  seller       Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Categoria        @relation(fields: [categoryId], references: [id])
  sales        Sale[]
  reservations Reserva[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([sellerId, status])
  @@index([title])
}

// Una venta = una línea de pedido del Buyer App.
// Múltiples ventas pueden compartir el mismo orderId (un pedido con varios productos).
model Sale {
  id        String     @id @default(cuid())
  orderId   String
  productId String
  sellerId  String
  buyerId   String
  paymentId String
  amount    Int
  total     Decimal    @db.Decimal(10, 2)
  fee       Decimal    @db.Decimal(10, 2)
  status    SaleStatus @default(pending_payment)
  product   Product    @relation(fields: [productId], references: [id])
  seller    Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sellerId, status])
  @@index([orderId])
  @@index([sellerId, createdAt])
}

// Reserva temporal de stock durante el proceso de checkout del Buyer App.
model Reserva {
  id        String   @id @default(cuid())
  productId String
  orderId   String
  buyerId   String
  quantity  Int
  expiresAt DateTime
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}
