# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Clerk (autenticación)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Supabase Storage (imágenes) — usa el nuevo formato de API keys (sb_secret_xxx).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx"

# Pexels API key (solo necesario para correr el seed). Se consigue gratis en
# https://www.pexels.com/api/ — se usa para buscar fotos por keyword y darle
# imágenes relacionadas a cada producto del seed.
PEXELS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Vercel AI Gateway — usado por el asistente "Completar con IA" del formulario
# de productos. Se obtiene desde el dashboard de Vercel (AI Gateway → API Keys).
# El AI SDK lo levanta automáticamente cuando el modelo se pasa como string
# "provider/model" (ver lib/ai/product-draft.ts).
AI_GATEWAY_API_KEY="vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shipping App — base URL para llamar al endpoint de envíos. En desarrollo
# individual apunta al propio host (mock en app/api/shipping/envios). Cuando
# se integre la Shipping App real apuntará a su deploy.
SHIPPING_SERVICE_URL="http://localhost:3000"

# API key compartida que la Shipping App acepta de todos sus consumers. Se
# envía como header `X-API-Key-Hash: sha256(<key>)` (hex). En integración real
# la provee el dueño de la Shipping App; para el mock local usá cualquier string
# opaco (el SHA-256 se calcula en código, no lo pongas hasheado acá).
SHIPPING_API_KEY="dev_shipping_change_me"

# API key que la Seller App exige en sus endpoints públicos (consumidos por
# Buyer, Payments y Shipping). Se envía como header `X-API-Key-Hash: sha256(<key>)`
# (hex). Acá va la key cruda; el hashing lo hace el código en ambos extremos.
SELLER_INTERNAL_API_KEY="dev_seller_internal_change_me"

# TTL en minutos para las reservas de stock creadas por POST /productos/:id/reservar.
# La Seller App asigna `expires_at = now + RESERVATION_TTL_MINUTES` al crear la reserva.
RESERVATION_TTL_MINUTES=30

# Secret que Vercel Cron envía como `Authorization: Bearer <CRON_SECRET>` al
# llamar al endpoint `/api/internal/sweep-reservas` (configurado en vercel.json,
# corre 1 vez por día — límite del plan Hobby — y borra Reservas expiradas
# restaurando su stock). El gap entre corridas lo cubre el lazy sweep dentro
# de createReserva (lib/data/reservations.ts). Vercel inyecta esta env var
# automáticamente en producción si está definida en el proyecto; en local
# podés setearla con cualquier valor para probar el endpoint.
CRON_SECRET="dev_cron_change_me"

# DB de test. Usa la MISMA instancia de Postgres que DATABASE_URL pero con
# un schema dedicado vía `?schema=test`. El setup de Vitest (tests/setup.ts)
# valida que el schema sea distinto de `public` y aplica el modelo ahí con
# `prisma db push`. No usar pgbouncer/pooler para el URL de test — `db push`
# necesita conexión directa.
DATABASE_URL_TEST="postgresql://postgres.xxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=test"
